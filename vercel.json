{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["cdg1"],
  "crons": [
    {
      "path": "/api/cron/daily-reminder",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/cleanup-inactive",
      "schedule": "0 2 * * 0"
    }
  ]
}
